{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|api/|demo/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/keep-alive", "schedule": "0 11 * * *" }]
}
